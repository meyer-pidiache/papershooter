# Browser-visible settings. Never put provider secrets in VITE_*.
# Static/native builds default to public/ice-servers.json; an empty override disables STUN.
# VITE_STUN_SERVERS=stun:your-stun.example:3478
# VITE_ICE_CONFIG_URL=/ice-servers.json
# Enable temporary relay credentials when a provider is configured:
# VITE_TURN_CREDENTIALS_URL=/api/turn-credentials
# VITE_PEER_HOST=your-peer-server.example
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/peerjs
# VITE_PEER_SECURE=true
# VITE_LOBBY_NAMESPACE=your-paper-game-

# Private runtime configuration. Choose none, cloudflare or coturn.
TURN_PROVIDER=none
TURN_TTL_SECONDS=3600
PAPERSHOOT_STUN_SERVERS=stun:stun.cloudflare.com:3478
PAPERSHOOT_PORT=8901
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
TURN_URLS=
TURN_SHARED_SECRET=
# Enable only behind a private trusted proxy that overwrites X-Real-IP.
TRUST_PROXY=false
TRUST_PROXY_HEADER=x-real-ip
# Optional comma-separated HTTPS frontend origins for a separately hosted API.
ALLOWED_ORIGINS=
