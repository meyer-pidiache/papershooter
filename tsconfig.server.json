{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "noEmit": false,
    "allowJs": false,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/shared/ice.ts"],
  "exclude": ["server/vercel-handler.ts"]
}
